{
  "name": "poker-defense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "waves": "node scripts/generate-waves.mjs",
    "sim": "tsx scripts/simulate.ts",
    "shards": "tsx scripts/hero-shard-report.ts",
    "draw": "tsx scripts/draw-assist-report.ts",
    "build:fn": "esbuild src/net/verifyServer.ts --bundle --format=esm --platform=neutral --outfile=supabase/functions/_shared/verify.js",
    "db:push": "supabase db push",
    "fn:deploy": "npm run build:fn && supabase functions deploy verify-match",
    "smoke:online": "tsx scripts/smoke-online.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
