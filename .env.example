# Supabase 프로젝트 (docs/server-setup.md). 복사해서 .env.local 로 저장 — .env* 는 커밋하지 않는다.
# anon key는 공개돼도 되는 키다(RLS가 지킨다). service_role key는 절대 클라이언트·저장소에 넣지 않는다.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# 초대 링크 도메인 (없으면 현재 origin)
VITE_INVITE_BASE=https://pokerdefense.app
