# Supabase 프로젝트 (docs/server-setup.md). 복사해서 .env.local 로 저장 — .env* 는 커밋하지 않는다.
# anon key는 공개돼도 되는 키다(RLS가 지킨다). service_role key는 절대 클라이언트·저장소에 넣지 않는다.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# 초대 링크 도메인 (없으면 현재 origin)
VITE_INVITE_BASE=https://pokerdefense.app
# AdMob (Android 앱). 비워 두면 Google 테스트 광고. 실제 ID는 출시 직전에만 넣고 PRODUCTION=1 (docs/release-android.md)
VITE_ADMOB_REWARDED_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_PRODUCTION=0
